---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AboutV3Hero from '@/components/sections/about-v3/AboutV3Hero.astro';
import LogoMarquee from '@/components/sections/shared/LogoMarquee.astro';
import AboutV3Intro from '@/components/sections/about-v3/AboutV3Intro.astro';
import AboutV3Mission from '@/components/sections/about-v3/AboutV3Mission.astro';
import AboutV3Team from '@/components/sections/about-v3/AboutV3Team.astro';
import TestimonialsV3 from '@/components/sections/shared/TestimonialsV3.astro';
