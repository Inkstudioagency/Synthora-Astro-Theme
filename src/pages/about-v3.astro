import BlogV3 from '@/components/sections/shared/BlogV3.astro';
import CtaV3 from '@/components/sections/shared/CtaV3.astro';
---

<BaseLayout
  wfPage="6b03d9375de33e5d414c268c"
  title="About V3 - Vision, Values and Leadership | Synthora"
  description="Synthora About V3 layout: the vision, milestones, values and leadership behind an AI automation platform trusted by fast-growing teams around the world."
>
  <AboutV3Hero />
  <LogoMarquee />
  <div class="section-divider"></div>
  <AboutV3Intro />
  <div class="section-divider"></div>
  <AboutV3Mission />
  <div class="section-divider"></div>
  <AboutV3Team />
  <div class="section-divider"></div>
  <TestimonialsV3 />
  <div class="section-divider"></div>
  <FaqTabs />
  <div class="section-divider"></div>
  <BlogV3 />
  <div class="section-divider"></div>
  <CtaV3 />
  <div class="section-divider"></div>
</BaseLayout>
