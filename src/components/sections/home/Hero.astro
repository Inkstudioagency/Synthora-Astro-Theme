---
import { linkFor } from '@/lib/links';
const link = linkFor(Astro.url.pathname);
---

<section class="section_hero">
        <div class="home-hero-pattern"></div>
        <div class="container-main">
          <div class="home-hero-wrapper">
            <div class="home-hero-content">
              <div class="home-hero-text">
                <h1 hero-title="" class="home-hero-title">Turn Workflow Into<br>AI Agent Automations</h1>
                <p page-load-2="" class="home-hero-summary">Powerful and production-ready, our cloud platform has the solutions you need to succeed.</p>
              </div>
              <div page-load-3="" class="button-row">
                <a data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;],[&quot;3aaebc1b-e222-def7-42a7-b991c70b0117&quot;]]]" data-wf-component-id="403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4" data-wf-variant-state="base" {...link('/pricing', 'primary-button w-inline-block')}>
                  <div class="button-text-mask">
                    <div data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f6&quot;],[&quot;3aaebc1b-e222-def7-42a7-b991c70b0117&quot;]]]" class="button-text">Start For Free</div>
                    <div data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f8&quot;],[&quot;3aaebc1b-e222-def7-42a7-b991c70b0117&quot;]]]" class="button-text is-hover">Start For Free</div>
                  </div>
                  <div data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34fa&quot;],[&quot;3aaebc1b-e222-def7-42a7-b991c70b0117&quot;]]]" class="button-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 16 15" fill="currentColor" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="10.666" cy="3.2" r="1.067"></circle>
                      <circle cx="8.533" cy="1.067" r="1.067"></circle>
                      <circle cx="14.933" cy="7.466" r="1.067"></circle>
                      <circle cx="1.067" cy="7.466" r="1.067"></circle>
                      <circle cx="4.268" cy="7.466" r="1.067"></circle>
                      <circle cx="7.467" cy="7.466" r="1.067"></circle>
                      <circle cx="10.666" cy="7.466" r="1.067"></circle>
                      <circle cx="12.8" cy="9.6" r="1.067"></circle>
                      <circle cx="10.666" cy="11.733" r="1.067"></circle>
                      <circle cx="8.533" cy="13.866" r="1.067"></circle>
                      <circle cx="12.8" cy="5.333" r="1.067"></circle>
                    </svg></div>
                </a>
                <a data-wf-target="[[[&quot;2327f0b1-22dd-4a01-6298-d1f19bcbffe7&quot;,&quot;2327f0b1-22dd-4a01-6298-d1f19bcbffe7&quot;],[&quot;21689464-8fcc-8253-a2c9-ed78bde275a8&quot;]]]" data-wf-component-id="2327f0b1-22dd-4a01-6298-d1f19bcbffe7" data-wf-variant-state="base" {...link('/contact', 'secondary-button w-inline-block')}>
                  <div class="button-text-mask">
                    <div data-wf-target="[[[&quot;2327f0b1-22dd-4a01-6298-d1f19bcbffe7&quot;,&quot;2327f0b1-22dd-4a01-6298-d1f19bcbffe9&quot;],[&quot;21689464-8fcc-8253-a2c9-ed78bde275a8&quot;]]]" class="button-text">Talk To Sales</div>
                    <div data-wf-target="[[[&quot;2327f0b1-22dd-4a01-6298-d1f19bcbffe7&quot;,&quot;2327f0b1-22dd-4a01-6298-d1f19bcbffeb&quot;],[&quot;21689464-8fcc-8253-a2c9-ed78bde275a8&quot;]]]" class="button-text is-hover">Talk To Sales</div>
                  </div>
                </a>
              </div>
            </div>
            <div page-load-4="" class="home-hero-stats">
              <div class="home-hero-stat-card">
                <div class="corner-dots">
                  <div class="corner-dot is-tl"></div>
                  <div class="corner-dot is-tr"></div>
                  <div class="corner-dot is-bl"></div>
                  <div class="corner-dot is-br"></div>
                </div>
                <div data-counter="counter" class="home-hero-stat-number">200K+</div>
                <div class="home-hero-stat-label">Active users worldwide</div>
              </div>
              <div class="home-hero-stat-card">
                <div class="corner-dots">
                  <div class="corner-dot is-tl"></div>
                  <div class="corner-dot is-tr"></div>
                  <div class="corner-dot is-bl"></div>
                  <div class="corner-dot is-br"></div>
                </div>
                <div data-counter="counter" class="home-hero-stat-number">815K</div>
                <div class="home-hero-stat-label">AI automations used</div>
              </div>
            </div>
          </div>
        </div>
        <div class="home-hero-visual">
          <div class="home-hero-visual-image" data-w-id="6eb662e6-0e1a-a787-48e1-206e5a85b624" data-animation-type="lottie" data-src="/documents/04-agent-import-stack.json" data-loop="0" data-direction="1" data-autoplay="1" data-is-ix2-target="0" data-renderer="svg" data-default-duration="5.5" data-duration="0" data-loading="eager"></div>
        </div>
      </section>
