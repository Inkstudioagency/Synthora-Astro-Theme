                </div>
                <h2 section-title="" class="heading-style-2">Flexible Pricing That Scales With You</h2>
              </div>
              <div data-reveal="stagger" class="home-pricing-grid">
                <div class="home-pricing-card">
                  <div class="corner-dots">
                    <div class="corner-dot is-tl"></div>
                    <div class="corner-dot is-tr"></div>
                    <div class="corner-dot is-bl"></div>
                    <div class="corner-dot is-br"></div>
