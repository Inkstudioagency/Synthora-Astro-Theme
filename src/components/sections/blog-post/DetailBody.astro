---
import { renderBlocks } from '@/lib/blocks';
import type { BlogPost } from '@/lib/content';
interface Props {
  entry: BlogPost;
}
const { entry } = Astro.props;
---

<section class="section_detail-body">
        <div class="section-gap">
          <div class="container-main">
            <div class="detail-layout">
              <div reveal-anim-1="" class="detail-main">
                <p class="detail-lead">{entry.lead}</p>
                <div class="detail-rich-text w-richtext" set:html={renderBlocks(entry.body)}></div>
              </div>
              <div reveal-anim-2="" class="detail-sidebar">
                <div class="detail-card">
                  <div class="corner-dots">
                    <div class="corner-dot is-tl"></div>
                    <div class="corner-dot is-tr"></div>
                    <div class="corner-dot is-bl"></div>
                    <div class="corner-dot is-br"></div>
                  </div>
                  <div class="blog-subscribe-header">
                    <div class="blog-card-date">SUBSCRIBE</div>
                    <h2 class="detail-card-title">Get updates straight in your inbox with post</h2>
                  </div>
                  <div class="contact-form-block w-form">
                    <form id="wf-form-Post-Subscribe-Form" name="wf-form-Post-Subscribe-Form" data-name="Post Subscribe Form" method="get" class="blog-subscribe-form" data-wf-page-id="6b03d9375de33e5d414c2687" data-wf-element-id="afe70720-045d-60c4-0d8e-17b5d8ac314e"><label for="subscribe-email" class="contact-v2-form-label">Email address</label><input class="blog-cta-form-input w-input" maxlength="256" name="email" data-name="Email" placeholder="Email address" type="email" id="subscribe-email" required=""><input type="submit" data-wait="Subscribing..." class="contact-form-submit is-full w-button" value="Subscribe"></form>
                    <div class="contact-form-message w-form-done">
                      <div>Thank you for subscribing! New posts will land in your inbox.</div>
                    </div>
                    <div class="contact-form-message w-form-fail">
                      <div>Something went wrong while subscribing. Please try again.</div>
                    </div>
                  </div>
                </div>
                <div class="contact-v2-social-card">
                  <h2 class="heading-style-6">Share this post</h2>
                  <div class="contact-social-list">
                    <a aria-label="Share on Instagram" href="https://www.instagram.com/" target="_blank" class="contact-social-link w-inline-block">
                      <div class="contact-social-icon w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                          <rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect>
                          <circle cx="12" cy="12" r="4"></circle>
                          <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"></circle>
                        </svg></div>
                    </a>
                    <a aria-label="Share on Facebook" href="https://www.facebook.com/" target="_blank" class="contact-social-link w-inline-block">
                      <div class="contact-social-icon w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M13.5 21v-8h2.7l.4-3.200h-3.100V7.800c0-.9.3-1.600 1.600-1.600h1.700V3.300a22 22 0 0 0-2.400-.1c-2.400 0-4.100 1.500-4.100 4.200v2.400H7.600V13h2.700v8z"></path>
                        </svg></div>
                    </a>
                    <a aria-label="Share on X" href="https://x.com/" target="_blank" class="contact-social-link w-inline-block">
                      <div class="contact-social-icon w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M17.75 3h3.07l-6.7 7.66L22 21h-6.17l-4.83-6.32L5.47 21H2.4l7.17-8.2L2 3h6.33l4.37 5.78zm-1.08 16.2h1.7L7.4 4.7H5.58z"></path>
                        </svg></div>
                    </a>
                    <a aria-label="Share on LinkedIn" href="https://www.linkedin.com/" target="_blank" class="contact-social-link w-inline-block">
                      <div class="contact-social-icon w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M6.9 5.2a1.9 1.9 0 1 1-3.8 0 1.9 1.9 0 0 1 3.8 0zM3.4 8.6h3.3V20H3.4zM9.1 8.6h3.1v1.6c.6-1 1.8-1.900 3.600-1.900 3.400 0 4.200 2.200 4.200 5.200V20h-3.300v-5.800c0-1.400-.3-2.700-1.900-2.700-1.700 0-2.300 1.200-2.300 2.800V20H9.100z"></path>
                        </svg></div>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
