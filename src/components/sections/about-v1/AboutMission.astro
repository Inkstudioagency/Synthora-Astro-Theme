        <div class="section-gap is-sticky">
          <div class="container-main">
            <div data-reveal="fade-up" data-current="Tab 1" data-easing="ease" data-duration-in="300" data-duration-out="100" class="about-mission-tabs w-tabs">
              <div class="about-mission-menu w-tab-menu">
                <a data-w-tab="Tab 1" data-wf-target="[[[&quot;6b03d9375de33e5d414c268a&quot;,&quot;6ed41236-811b-8e6b-4611-468e48e1b372&quot;],[]]]" class="about-mission-tab is-bar is-active w-inline-block w-tab-link w--current">
