---
import { linkFor } from '@/lib/links';
const link = linkFor(Astro.url.pathname);
---

<section class="section_stats-v3">
        <div class="section-gap">
          <div class="container-main">
            <div class="stats-v3-wrapper">
              <div data-reveal="fade-up" class="stats-v3-head">
                <div class="stats-v3-heading">
                  <div reveal-anim-1="" class="section-eyebrow">
                    <div class="eyebrow-dot"></div>
                    <div class="eyebrow-dot is-top-right"></div>
                    <div class="eyebrow-dot is-bottom-left"></div>
                    <div class="eyebrow-dot is-bottom-right"></div>
                    <div class="section-eyebrow-text">Our Impacts</div>
                  </div>
                  <h2 section-title="" class="heading-style-2">The Numbers That Define Our Success</h2>
                </div>
                <a data-wf-target="[[[&quot;1ed284f7-807c-746b-364b-85823408f81d&quot;,&quot;1ed284f7-807c-746b-364b-85823408f81d&quot;],[&quot;85efef0e-9769-8561-f1c8-2330cd35bcc3&quot;]]]" data-wf-component-id="1ed284f7-807c-746b-364b-85823408f81d" data-wf-variant-state="base" {...link('/about-v3', 'secondary-button is-gray w-inline-block')}>
                  <div class="button-text-mask">
                    <div data-wf-target="[[[&quot;1ed284f7-807c-746b-364b-85823408f81d&quot;,&quot;1ed284f7-807c-746b-364b-85823408f81f&quot;],[&quot;85efef0e-9769-8561-f1c8-2330cd35bcc3&quot;]]]" class="button-text">Learn About Us</div>
                    <div data-wf-target="[[[&quot;1ed284f7-807c-746b-364b-85823408f81d&quot;,&quot;1ed284f7-807c-746b-364b-85823408f820&quot;],[&quot;85efef0e-9769-8561-f1c8-2330cd35bcc3&quot;]]]" class="button-text is-hover">Learn About Us</div>
                  </div>
                </a>
              </div>
              <div data-reveal="stagger" class="stats-v3-list">
                <div class="stats-v3-row">
                  <div class="stats-v3-dot"></div>
                  <div data-counter="counter" class="stats-v3-number">98%</div>
                  <p class="stats-v3-text">Customer retention rate across enterprise implementations</p><img src="/images/synthora-v3-stats-1_1synthora-v3-stats-1.webp" loading="lazy" sizes="(max-width: 516px) 100vw, 516px" srcset="/images/synthora-v3-stats-1_1-p-500.webp 500w, /images/synthora-v3-stats-1_1synthora-v3-stats-1.webp 516w" alt="Team reviewing customer success metrics" class="stats-v3-image">
                </div>
                <div class="stats-v3-row">
                  <div class="stats-v3-dot"></div><img src="/images/synthora-v3-stats-2_1synthora-v3-stats-2.webp" loading="lazy" sizes="(max-width: 516px) 100vw, 516px" srcset="/images/synthora-v3-stats-2_1-p-500.webp 500w, /images/synthora-v3-stats-2_1synthora-v3-stats-2.webp 516w" alt="Sales dashboard showing pipeline growth" class="stats-v3-image is-start">
                  <p class="stats-v3-text">Increase in sales pipeline conversion and qualified leads</p>
                  <div data-counter="counter" class="stats-v3-number is-end">20X</div>
                </div>
                <div class="stats-v3-row">
                  <div class="stats-v3-dot"></div>
                  <div data-counter="counter" class="stats-v3-number">50+</div>
                  <p class="stats-v3-text">Million data points analyzed daily to predict market trends</p><img src="/images/synthora-v3-stats-3_1synthora-v3-stats-3.webp" loading="lazy" sizes="(max-width: 516px) 100vw, 516px" srcset="/images/synthora-v3-stats-3_1-p-500.webp 500w, /images/synthora-v3-stats-3_1synthora-v3-stats-3.webp 516w" alt="Analyst studying market trend data" class="stats-v3-image">
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
