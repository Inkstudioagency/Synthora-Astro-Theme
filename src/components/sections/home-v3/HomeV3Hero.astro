---
import { linkFor } from '@/lib/links';
const link = linkFor(Astro.url.pathname);
---

<section class="section_home-v3-hero">
        <div class="container-main">
          <div class="home-v3-hero-wrapper">
            <div class="home-v3-hero-content">
              <div class="home-v3-hero-text">
                <h1 hero-title="" class="heading-style-1">Turn Workflow Into<br>AI Agent Automations</h1>
                <p page-load-2="" class="home-v3-hero-summary">Powerful and production-ready, our cloud platform has the solutions you need to succeed.</p>
              </div>
              <div page-load-3="" class="home-v3-hero-buttons">
                <a data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;],[&quot;1dc1b706-facc-d3a9-e346-2943af1ee338&quot;]]]" data-wf-component-id="403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4" data-wf-variant-state="base" {...link('/pricing', 'primary-button w-inline-block')}>
