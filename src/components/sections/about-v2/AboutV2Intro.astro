<section class="section_about-v2-intro">
        <div class="section-gap">
          <div class="container-main">
            <div class="about-v2-intro-wrapper">
              <div data-reveal="fade-up" class="about-v2-intro-top">
                <div class="section-eyebrow">
                  <div class="eyebrow-dot"></div>
                  <div class="eyebrow-dot is-top-right"></div>
                  <div class="eyebrow-dot is-bottom-left"></div>
                  <div class="eyebrow-dot is-bottom-right"></div>
                  <div class="section-eyebrow-text">About</div>
                </div>
                <h2 text-scroll-reveal="" class="about-v2-intro-heading">We are an AI-first automation company dedicated to helping businesses solve complex operational challenges. We blend agent technology with hands-on onboarding to deliver measurable results. Our approach is simple: we listen, we automate, and we improve.</h2>
              </div>
              <div class="about-v2-intro-grid">
                <div class="about-v2-intro-visual"><img src="/images/synthora-about-v2-intro_1synthora-about-v2-intro.webp" loading="lazy" sizes="(max-width: 928px) 100vw, 928px" srcset="/images/synthora-about-v2-intro_1-p-500.webp 500w, /images/synthora-about-v2-intro_1-p-800.webp 800w, /images/synthora-about-v2-intro_1synthora-about-v2-intro.webp 928w" alt="Open-plan office with teams working at screens behind glass walls" class="about-v2-intro-image"></div>
