---
import { linkFor } from '@/lib/links';
const link = linkFor(Astro.url.pathname);
---

<section class="section_about-v2-story">
        <div class="section-gap">
          <div class="container-main">
            <div class="about-v2-story-wrapper">
              <div class="about-v2-section-header">
                <div reveal-anim-1="" class="section-eyebrow">
                  <div class="eyebrow-dot"></div>
                  <div class="eyebrow-dot is-top-right"></div>
                  <div class="eyebrow-dot is-bottom-left"></div>
                  <div class="eyebrow-dot is-bottom-right"></div>
                  <div class="section-eyebrow-text">Story</div>
                </div>
                <h2 section-title="" class="heading-style-2">From Kickoff To Launch, Our Effortless Process</h2>
              </div>
              <div data-reveal="fade-up" data-current="Tab 1" data-easing="ease" data-duration-in="300" data-duration-out="100" class="about-v2-story-tabs w-tabs">
                <div class="about-v2-story-menu w-tab-menu">
                  <a data-w-tab="Tab 1" class="about-v2-story-tab w-inline-block w-tab-link w--current">
                    <div class="about-v2-story-tab-text">Our Mission</div>
                  </a>
                  <a data-w-tab="Tab 2" class="about-v2-story-tab w-inline-block w-tab-link">
                    <div class="about-v2-story-tab-text">Our Vision</div>
                  </a>
                  <a data-w-tab="Tab 3" class="about-v2-story-tab w-inline-block w-tab-link">
                    <div class="about-v2-story-tab-text">Our Strategy</div>
                  </a>
                </div>
                <div class="about-v2-story-content w-tab-content">
                  <div data-w-tab="Tab 1" class="w-tab-pane w--tab-active">
                    <div class="about-v2-story-pane">
                      <div class="about-v2-story-card">
                        <div class="about-v2-story-card-body">
                          <h3 class="about-v2-story-title">Our Mission: Empowering Your Business Through AI-Powered Innovation</h3>
                          <p class="about-v2-story-text">Before an agent goes live, we sit down with your team to map what the workflow actually needs. What it has to do. Where it can flex. What can&#x27;t change. The plan that comes out of that conversation isn&#x27;t a guess dressed up as a proposal. It&#x27;s a direction your whole team already believes in.</p>
                        </div>
                        <a data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;],[&quot;cdf1dbe6-be5f-1fdd-ad8f-c5ebabd271a7&quot;]]]" data-wf-component-id="403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4" data-wf-variant-state="base" {...link('/contact-v2', 'primary-button w-inline-block')}>
                          <div class="button-text-mask">
                            <div data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f6&quot;],[&quot;cdf1dbe6-be5f-1fdd-ad8f-c5ebabd271a7&quot;]]]" class="button-text">Get In Touch</div>
                            <div data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f8&quot;],[&quot;cdf1dbe6-be5f-1fdd-ad8f-c5ebabd271a7&quot;]]]" class="button-text is-hover">Get In Touch</div>
                          </div>
                          <div data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34fa&quot;],[&quot;cdf1dbe6-be5f-1fdd-ad8f-c5ebabd271a7&quot;]]]" class="button-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 16 15" fill="currentColor" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                              <circle cx="10.666" cy="3.2" r="1.067"></circle>
                              <circle cx="8.533" cy="1.067" r="1.067"></circle>
                              <circle cx="14.933" cy="7.466" r="1.067"></circle>
                              <circle cx="1.067" cy="7.466" r="1.067"></circle>
                              <circle cx="4.268" cy="7.466" r="1.067"></circle>
                              <circle cx="7.467" cy="7.466" r="1.067"></circle>
                              <circle cx="10.666" cy="7.466" r="1.067"></circle>
                              <circle cx="12.8" cy="9.6" r="1.067"></circle>
                              <circle cx="10.666" cy="11.733" r="1.067"></circle>
                              <circle cx="8.533" cy="13.866" r="1.067"></circle>
                              <circle cx="12.8" cy="5.333" r="1.067"></circle>
                            </svg></div>
                        </a>
                      </div>
                      <div class="about-v2-story-visual"><img src="/images/synthora-about-v2-mission_1synthora-about-v2-mission.webp" loading="lazy" sizes="(max-width: 1288px) 100vw, 1288px" srcset="/images/synthora-about-v2-mission_1-p-500.webp 500w, /images/synthora-about-v2-mission_1-p-800.webp 800w, /images/synthora-about-v2-mission_1-p-1080.webp 1080w, /images/synthora-about-v2-mission_1synthora-about-v2-mission.webp 1288w" alt="Two engineers reviewing agent code together on a large monitor" class="about-v2-story-image"></div>
                    </div>
                  </div>
                  <div data-w-tab="Tab 2" class="w-tab-pane">
                    <div class="about-v2-story-pane">
                      <div class="about-v2-story-card">
                        <div class="about-v2-story-card-body">
                          <h3 class="about-v2-story-title">Our Vision: A World Where Every Team Works Alongside AI Agents</h3>
                          <p class="about-v2-story-text">We believe AI should take on the repetitive work so people can focus on judgment, creativity and customers. We are building toward a future where any team can launch a reliable agent in an afternoon, with full visibility into what it does and why.</p>
                        </div>
                        <a data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;],[&quot;44bfadf9-149b-4ce6-c09e-f89ca1075f74&quot;]]]" data-wf-component-id="403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4" data-wf-variant-state="base" {...link('/contact-v2', 'primary-button w-inline-block')}>
