                              <circle cx="12.8" cy="5.333" r="1.067"></circle>
                            </svg></div>
                        </a>
                      </div>
                      <div class="about-v2-story-visual"><img src="/images/synthora-about-v2-hero-4_1synthora-about-v2-hero-4.webp" loading="lazy" sizes="100vw" srcset="/images/synthora-about-v2-hero-4_1-p-500.webp 500w, /images/synthora-about-v2-hero-4_1synthora-about-v2-hero-4.webp 692w" alt="Team lead presenting the automation roadmap in a meeting room" class="about-v2-story-image"></div>
                    </div>
                  </div>
                  <div data-w-tab="Tab 3" class="w-tab-pane">
                    <div class="about-v2-story-pane">
                      <div class="about-v2-story-card">
                        <div class="about-v2-story-card-body">
                          <h3 class="about-v2-story-title">Our Strategy: Start Small, Measure Everything, Scale What Works</h3>
                          <p class="about-v2-story-text">We start with one high-impact workflow, ship it in weeks and track the results from day one. Every deployment comes with clear metrics, human-in-the-loop controls and a roadmap, so you expand automation with confidence instead of guesswork.</p>
                        </div>
                        <a data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;],[&quot;68d7abb4-8e25-5842-8f6f-d3d7b6468530&quot;]]]" data-wf-component-id="403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4" data-wf-variant-state="base" {...link('/contact-v2', 'primary-button w-inline-block')}>
