---
import { linkFor } from '@/lib/links';
const link = linkFor(Astro.url.pathname);
---

<section class="section_cta">
        <div class="section-gap">
          <div class="container-main">
            <div reveal-2s="" class="cta-panel is-v2">
              <div class="cta-panel-content is-v2">
                <div class="cta-panel-text is-v2">
                  <h2 section-title="" class="heading-style-2">Unleash The Power Of Efficiency Business</h2>
                  <p reveal-anim-2="" class="cta-panel-summary">Join leading enterprises using Synthora to scale operations, reduce costs, and deliver results faster than ever before.</p>
                </div>
                <a data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;],[&quot;978deae9-ecee-732a-d9bd-361388853c4f&quot;,&quot;8264a173-e6ae-d40d-7da9-bc6a3007dfe3&quot;]]]" data-wf-component-id="403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4" data-wf-variant-state="base" {...link('/contact', 'primary-button w-inline-block')}>
                  <div class="button-text-mask">
                    <div data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f6&quot;],[&quot;978deae9-ecee-732a-d9bd-361388853c4f&quot;,&quot;8264a173-e6ae-d40d-7da9-bc6a3007dfe3&quot;]]]" class="button-text">Book A Demo</div>
                    <div data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f8&quot;],[&quot;978deae9-ecee-732a-d9bd-361388853c4f&quot;,&quot;8264a173-e6ae-d40d-7da9-bc6a3007dfe3&quot;]]]" class="button-text is-hover">Book A Demo</div>
                  </div>
                  <div data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34fa&quot;],[&quot;978deae9-ecee-732a-d9bd-361388853c4f&quot;,&quot;8264a173-e6ae-d40d-7da9-bc6a3007dfe3&quot;]]]" class="button-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 16 15" fill="currentColor" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="10.666" cy="3.2" r="1.067"></circle>
                      <circle cx="8.533" cy="1.067" r="1.067"></circle>
                      <circle cx="14.933" cy="7.466" r="1.067"></circle>
                      <circle cx="1.067" cy="7.466" r="1.067"></circle>
                      <circle cx="4.268" cy="7.466" r="1.067"></circle>
                      <circle cx="7.467" cy="7.466" r="1.067"></circle>
                      <circle cx="10.666" cy="7.466" r="1.067"></circle>
                      <circle cx="12.8" cy="9.6" r="1.067"></circle>
                      <circle cx="10.666" cy="11.733" r="1.067"></circle>
                      <circle cx="8.533" cy="13.866" r="1.067"></circle>
                      <circle cx="12.8" cy="5.333" r="1.067"></circle>
                    </svg></div>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
