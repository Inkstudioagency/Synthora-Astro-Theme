---
import { linkFor } from '@/lib/links';
import { formatDate, getFeaturedPosts, postUrl } from '@/lib/content';
const link = linkFor(Astro.url.pathname);
const featured = await getFeaturedPosts();
---

<section class="section_blog-hero">
        <div class="section-gap is-small">
          <div class="container-main">
            <div class="blog-hero-wrapper">
              <div class="blog-hero-top">
                <div page-load-1="" class="blog-hero-back">
                  <a data-wf-target="[[[&quot;dc30b107-6718-b05a-ca3b-e4e8cecd0d95&quot;,&quot;dc30b107-6718-b05a-ca3b-e4e8cecd0d95&quot;],[&quot;2d0d6147-7eb3-5bc6-b3aa-17cc0a27b20a&quot;]]]" data-wf-component-id="dc30b107-6718-b05a-ca3b-e4e8cecd0d95" data-wf-variant-state="base" {...link('/', 'back-link w-inline-block')}>
                    <div data-wf-target="[[[&quot;dc30b107-6718-b05a-ca3b-e4e8cecd0d95&quot;,&quot;dc30b107-6718-b05a-ca3b-e4e8cecd0d99&quot;],[&quot;2d0d6147-7eb3-5bc6-b3aa-17cc0a27b20a&quot;]]]" class="button-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 16 15" fill="currentColor" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                        <g transform="matrix(-1 0 0 1 16 0)">
                          <circle cx="10.666" cy="3.2" r="1.067"></circle>
                          <circle cx="8.533" cy="1.067" r="1.067"></circle>
                          <circle cx="14.933" cy="7.466" r="1.067"></circle>
                          <circle cx="1.067" cy="7.466" r="1.067"></circle>
                          <circle cx="4.268" cy="7.466" r="1.067"></circle>
                          <circle cx="7.467" cy="7.466" r="1.067"></circle>
                          <circle cx="10.666" cy="7.466" r="1.067"></circle>
                          <circle cx="12.8" cy="9.6" r="1.067"></circle>
                          <circle cx="10.666" cy="11.733" r="1.067"></circle>
                          <circle cx="8.533" cy="13.866" r="1.067"></circle>
                          <circle cx="12.8" cy="5.333" r="1.067"></circle>
                        </g>
                      </svg></div>
                    <div class="button-text-mask">
                      <div data-wf-target="[[[&quot;dc30b107-6718-b05a-ca3b-e4e8cecd0d95&quot;,&quot;dc30b107-6718-b05a-ca3b-e4e8cecd0d97&quot;],[&quot;2d0d6147-7eb3-5bc6-b3aa-17cc0a27b20a&quot;]]]" class="button-text">Back To Homepage</div>
                      <div data-wf-target="[[[&quot;dc30b107-6718-b05a-ca3b-e4e8cecd0d95&quot;,&quot;dc30b107-6718-b05a-ca3b-e4e8cecd0d98&quot;],[&quot;2d0d6147-7eb3-5bc6-b3aa-17cc0a27b20a&quot;]]]" class="button-text is-hover">Back To Homepage</div>
                    </div>
                  </a>
                </div>
                <div class="blog-hero-header">
                  <h1 hero-title="" class="heading-style-1">Blogs And Insights</h1>
                  <p page-load-2="" class="blog-hero-summary">Product news, practical guides and ideas from the team building production-ready AI agents.</p>
                </div>
              </div>
              <div class="blog-hero-feature">
                <div class="w-dyn-list">
  {
    featured.length > 0 ? (
      <div page-load-3="" role="list" class="blog-feature-list w-dyn-items">
        {featured.map((post) => (
          <div role="listitem" class="blog-feature-item w-dyn-item">
                      <div class="blog-feature-card">
                        <a tabindex="-1" aria-label="blog-feature-image-wrapper" {...link(postUrl(post.slug), 'blog-feature-image-wrapper w-inline-block')}><img src={post.thumbnail?.url} loading="lazy" aria-label="blog-v3-image" alt={post.thumbnail?.alt} class="blog-v3-image"></a>
                        <div class="blog-feature-body">
                          <div class="blog-feature-meta">
                            <div class="blog-card-tag">{post.category}</div>
                            <div class="blog-card-date">{formatDate(post.publishedDate)}</div>
                          </div>
                          <div class="blog-feature-text">
                            <a {...link(postUrl(post.slug), 'blog-card-title-block w-inline-block')}>
                              <h2 aria-label="blog-card-title" class="blog-card-title">{post.title}</h2>
                            </a>
                            <p class="text-size-small">{post.excerpt}</p>
                          </div>
                        </div>
                      </div>
                    </div>
        ))}
      </div>
    ) : (
      <div class="w-dyn-empty">
                    <div>No items found.</div>
                  </div>
    )
  }
</div>
              </div>
            </div>
          </div>
        </div>
      </section>
