---
import { linkFor } from '@/lib/links';
import { formatDate, getPosts, postUrl } from '@/lib/content';
const link = linkFor(Astro.url.pathname);
const posts = await getPosts();
---

<section class="section_blog-list">
        <div class="section-gap">
          <div class="container-main">
            <div class="blog-list-wrapper">
              <h2 section-title="" class="heading-style-3">Latest Articles</h2>
              <div class="blog-list-layout">
                <div class="blog-list-main">
                  <div class="w-dyn-list">
  {
    posts.length > 0 ? (
      <div data-reveal="stagger" role="list" class="blog-list w-dyn-items">
        {posts.map((post) => (
          <div role="listitem" class="home-blog-item w-dyn-item">
                        <div class="blog-card">
                          <a tabindex="-1" aria-label="blog-card-image-wrapper" {...link(postUrl(post.slug), 'blog-card-image-wrapper w-inline-block')}><img src={post.thumbnail?.url} loading="lazy" aria-label="blog-card-image" alt={post.thumbnail?.alt} class="blog-card-image is-compact"></a>
                          <div class="blog-card-body">
                            <div class="blog-card-meta">
                              <div class="blog-card-tag">{post.category}</div>
                              <div class="blog-card-date">{formatDate(post.publishedDate)}</div>
                            </div>
                            <a {...link(postUrl(post.slug), 'blog-card-title-block w-inline-block')}>
                              <h3 aria-label="blog-card-title" class="blog-card-title">{post.title}</h3>
                            </a>
                          </div>
                        </div>
                      </div>
        ))}
      </div>
    ) : (
      <div class="w-dyn-empty">
                      <div>No items found.</div>
                    </div>
    )
  }
</div>
                </div>
                <div reveal-anim-2="" class="blog-subscribe-card">
                  <div class="corner-dots">
                    <div class="corner-dot is-tl"></div>
                    <div class="corner-dot is-tr"></div>
                    <div class="corner-dot is-bl"></div>
                    <div class="corner-dot is-br"></div>
                  </div>
                  <div class="blog-subscribe-header">
                    <div class="blog-card-date">SUBSCRIBE</div>
                    <h2 class="heading-style-5">Get Posts Straight In Your Inbox</h2>
                  </div>
                  <div class="contact-form-block w-form">
                    <form id="wf-form-Blog-Subscribe-Form" name="wf-form-Blog-Subscribe-Form" data-name="Blog Subscribe Form" method="get" class="blog-subscribe-form" data-wf-page-id="6b03d9375de33e5d414c2696" data-wf-element-id="ec7fbb2f-a391-13f0-f4b0-6e1e832f7512"><label for="subscribe-email" class="contact-v2-form-label">Email address</label><input class="blog-cta-form-input w-input" maxlength="256" name="email" data-name="Email" placeholder="Email address" type="email" id="subscribe-email" required=""><input type="submit" data-wait="Subscribing..." class="contact-form-submit is-full w-button" value="Submit"></form>
                    <div class="contact-form-message w-form-done">
                      <div>Thank you for subscribing! New posts will land in your inbox.</div>
                    </div>
                    <div class="contact-form-message w-form-fail">
                      <div>Something went wrong while subscribing. Please try again.</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
