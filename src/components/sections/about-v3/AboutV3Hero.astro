---
import { linkFor } from '@/lib/links';
const link = linkFor(Astro.url.pathname);
---

<section class="section_about-v3-hero">
        <div class="home-hero-pattern"></div>
        <div class="section-gap is-small">
          <div class="container-main">
            <div class="about-v3-hero-wrapper">
              <div class="about-v3-hero-top">
                <div class="about-v3-hero-content">
                  <div class="about-v3-hero-text">
                    <h1 hero-title="" class="heading-style-1">Turn Workflow Into
                      AI Agent Automations</h1>
                    <p page-load-2="" class="home-v3-hero-summary">Powerful and production-ready, our cloud platform has the solutions you need to succeed.</p>
                  </div>
                  <div page-load-3="" class="button-row">
                    <a data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;],[&quot;1d696217-f371-d199-cb38-c91c49d1fae3&quot;]]]" data-wf-component-id="403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4" data-wf-variant-state="base" {...link('/pricing', 'primary-button w-inline-block')}>
                      <div class="button-text-mask">
                        <div data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f6&quot;],[&quot;1d696217-f371-d199-cb38-c91c49d1fae3&quot;]]]" class="button-text">Start For Free</div>
                        <div data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f8&quot;],[&quot;1d696217-f371-d199-cb38-c91c49d1fae3&quot;]]]" class="button-text is-hover">Start For Free</div>
                      </div>
                      <div data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34fa&quot;],[&quot;1d696217-f371-d199-cb38-c91c49d1fae3&quot;]]]" class="button-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 16 15" fill="currentColor" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                          <circle cx="10.666" cy="3.2" r="1.067"></circle>
                          <circle cx="8.533" cy="1.067" r="1.067"></circle>
                          <circle cx="14.933" cy="7.466" r="1.067"></circle>
                          <circle cx="1.067" cy="7.466" r="1.067"></circle>
                          <circle cx="4.268" cy="7.466" r="1.067"></circle>
                          <circle cx="7.467" cy="7.466" r="1.067"></circle>
                          <circle cx="10.666" cy="7.466" r="1.067"></circle>
                          <circle cx="12.8" cy="9.6" r="1.067"></circle>
                          <circle cx="10.666" cy="11.733" r="1.067"></circle>
                          <circle cx="8.533" cy="13.866" r="1.067"></circle>
                          <circle cx="12.8" cy="5.333" r="1.067"></circle>
                        </svg></div>
                    </a>
                  </div>
                </div>
                <div page-load-4="" class="about-v3-hero-aside">
                  <div class="about-v3-hero-media"><img src="/images/synthora-about-v3-promo_1synthora-about-v3-promo.webp" loading="lazy" sizes="(max-width: 796px) 100vw, 796px" srcset="/images/synthora-about-v3-promo_1-p-500.webp 500w, /images/synthora-about-v3-promo_1synthora-about-v3-promo.webp 796w" alt="Engineer reviewing AI agent workflows across two monitors" class="about-v3-hero-media-image">
                    <div class="about-v3-hero-media-overlay"></div>
                    <a href="#" aria-label="Play promo video" class="promo-v3-play is-centered w-inline-block w-lightbox">
                      <div class="promo-v3-play-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 10 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                          <path d="M7.85869 4.85186C8.39782 5.17043 8.39782 5.95045 7.85869 6.26901L1.24614 10.1765C0.697485 10.5007 0.0043945 10.1051 0.00439453 9.46782L0.00439487 1.65302C0.0043949 1.01574 0.697486 0.620243 1.24614 0.944443L7.85869 4.85186Z" fill="currentColor"></path>
                        </svg></div>
                      <div class="promo-v3-play-text">Play Promo Video</div>
                      <script is:inline type="application/json" class="w-json">{
  "items": [
    {
      "url": "https://www.youtube.com/watch?v=setu9Ir1miY&list=PLPmnoMVpkxfj-DzMkYNf7LM3ebjwoY6b2",
      "originalUrl": "https://www.youtube.com/watch?v=setu9Ir1miY&list=PLPmnoMVpkxfj-DzMkYNf7LM3ebjwoY6b2",
      "width": 940,
      "height": 528,
      "thumbnailUrl": "https://i.ytimg.com/vi/setu9Ir1miY/hqdefault.jpg",
      "html": "<iframe class=\"embedly-embed\" src=\"//cdn.embedly.com/widgets/media.html?src=https%3A%2F%2Fwww.youtube.com%2Fembed%2Fsetu9Ir1miY%3Flist%3DPLPmnoMVpkxfj-DzMkYNf7LM3ebjwoY6b2&display_name=YouTube&url=https%3A%2F%2Fwww.youtube.com%2Fwatch%3Fv%3Dsetu9Ir1miY&image=https%3A%2F%2Fi.ytimg.com%2Fvi%2Fsetu9Ir1miY%2Fhqdefault.jpg&type=text%2Fhtml&schema=youtube\" width=\"940\" height=\"528\" scrolling=\"no\" title=\"YouTube embed\" frameborder=\"0\" allow=\"autoplay; fullscreen; encrypted-media; picture-in-picture\" allowfullscreen=\"true\"></iframe>",
      "type": "video"
    }
  ],
  "group": ""
}</script>
                    </a>
                  </div>
                  <a href="#about" class="about-v3-hero-scroll w-inline-block">
                    <div>Scroll Down</div><svg aria-hidden="true" fill="none" viewBox="0 0 24 24" height="100%" width="100%" class="about-v3-hero-scroll-icon about-v3-hero-scroll-icon">
                      <path stroke-linejoin="round" stroke-linecap="round" stroke-width="1.5" stroke="currentColor" d="M12 5v14"></path>
                      <path stroke-linejoin="round" stroke-linecap="round" stroke-width="1.5" stroke="currentColor" d="M18 13l-6 6-6-6"></path>
                    </svg>
                  </a>
                </div>
              </div>
              <div page-load-5="" class="about-v3-hero-image-wrap"><img src="/images/synthora-about-v3-hero_1synthora-about-v3-hero.webp" loading="lazy" sizes="(max-width: 2560px) 100vw, 2560px" srcset="/images/synthora-about-v3-hero_1-p-500.webp 500w, /images/synthora-about-v3-hero_1-p-800.webp 800w, /images/synthora-about-v3-hero_1-p-1080.webp 1080w, /images/synthora-about-v3-hero_1-p-1600.webp 1600w, /images/synthora-about-v3-hero_1-p-2000.webp 2000w, /images/synthora-about-v3-hero_1synthora-about-v3-hero.webp 2560w" alt="Synthora team planning AI agent automations around a shared office table" class="about-v3-hero-image"></div>
            </div>
          </div>
        </div>
      </section>
