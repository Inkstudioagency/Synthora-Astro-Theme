---
import { linkFor } from '@/lib/links';
const link = linkFor(Astro.url.pathname);
---

<section id="about" class="section_about-v3-intro">
        <div class="section-gap">
          <div class="container-main">
            <div class="about-v3-intro-wrapper">
              <div class="section-header is-center">
                <div reveal-anim-1="" class="section-eyebrow">
                  <div class="eyebrow-dot"></div>
                  <div class="eyebrow-dot is-top-right"></div>
                  <div class="eyebrow-dot is-bottom-left"></div>
                  <div class="eyebrow-dot is-bottom-right"></div>
                  <div class="section-eyebrow-text">About</div>
                </div>
                <h2 section-title="" class="heading-style-2">Discover The Qualities That Set Us Apart</h2>
              </div>
              <div data-reveal="stagger" class="about-v3-intro-grid">
                <div class="about-v3-card">
                  <div class="about-v3-card-top">
                    <div class="about-v3-status">
                      <div class="about-v3-status-dot"></div>
                      <div class="about-v3-status-text">Exploring New Possibilities</div>
                    </div>
                    <h3 class="about-v3-card-title">Let’s Grow Your Business With AI</h3>
                    <p class="about-v3-card-text">Together, we’ll build a powerful digital plan around your workflows.</p>
                  </div>
                  <div class="about-v3-person"><img src="/images/synthora-about-v3-maya_1synthora-about-v3-maya.webp" loading="lazy" alt="Portrait of Maya Singh, Head of Marketing" class="about-v3-person-image">
                    <div class="about-v3-person-info">
                      <div class="about-v3-person-name">Maya Singh</div>
                      <div class="about-v3-person-role">Head of Marketing</div>
                    </div>
                  </div>
                  <div class="corner-dots">
                    <div class="corner-dot is-tl"></div>
                    <div class="corner-dot is-tr"></div>
                    <div class="corner-dot is-bl"></div>
                    <div class="corner-dot is-br"></div>
                  </div>
                </div>
                <div class="about-v3-stack">
                  <div class="about-v3-card is-stat">
                    <div data-counter="counter" class="about-v3-stat-number">120+</div>
                    <p class="about-v3-card-text">Global brands across the world</p>
                    <div class="corner-dots">
                      <div class="corner-dot is-tl"></div>
                      <div class="corner-dot is-tr"></div>
                      <div class="corner-dot is-bl"></div>
                      <div class="corner-dot is-br"></div>
                    </div>
                  </div>
                  <div class="about-v3-card is-grow">
                    <div class="about-v3-stat-content">
                      <div data-counter="counter" class="about-v3-stat-number">82%</div>
                      <p class="about-v3-card-text">Higher than the industry average across all campaigns</p>
                    </div>
                    <div class="button-row">
                      <a data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;],[&quot;d2486648-3a6a-2a2c-008d-52c965d7a338&quot;]]]" data-wf-component-id="403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4" data-wf-variant-state="base" {...link('/pricing', 'primary-button w-inline-block')}>
                        <div class="button-text-mask">
                          <div data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f6&quot;],[&quot;d2486648-3a6a-2a2c-008d-52c965d7a338&quot;]]]" class="button-text">Start For Free</div>
                          <div data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f8&quot;],[&quot;d2486648-3a6a-2a2c-008d-52c965d7a338&quot;]]]" class="button-text is-hover">Start For Free</div>
                        </div>
                        <div data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34fa&quot;],[&quot;d2486648-3a6a-2a2c-008d-52c965d7a338&quot;]]]" class="button-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 16 15" fill="currentColor" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="10.666" cy="3.2" r="1.067"></circle>
                            <circle cx="8.533" cy="1.067" r="1.067"></circle>
                            <circle cx="14.933" cy="7.466" r="1.067"></circle>
                            <circle cx="1.067" cy="7.466" r="1.067"></circle>
                            <circle cx="4.268" cy="7.466" r="1.067"></circle>
                            <circle cx="7.467" cy="7.466" r="1.067"></circle>
                            <circle cx="10.666" cy="7.466" r="1.067"></circle>
                            <circle cx="12.8" cy="9.6" r="1.067"></circle>
                            <circle cx="10.666" cy="11.733" r="1.067"></circle>
                            <circle cx="8.533" cy="13.866" r="1.067"></circle>
                            <circle cx="12.8" cy="5.333" r="1.067"></circle>
                          </svg></div>
                      </a>
                    </div>
                    <div class="corner-dots">
                      <div class="corner-dot is-tl"></div>
                      <div class="corner-dot is-tr"></div>
                      <div class="corner-dot is-bl"></div>
                      <div class="corner-dot is-br"></div>
                    </div>
                  </div>
                </div>
                <div class="about-v3-card is-wide">
                  <h3 class="about-v3-card-title">We’ll Build A Strong <span class="about-v3-card-muted">Digital Plan.</span></h3>
                  <div class="about-v3-card-media"><img src="/images/synthora-about-v3-roadmap_1synthora-about-v3-roadmap.webp" loading="lazy" sizes="100vw" srcset="/images/synthora-about-v3-roadmap_1-p-500.webp 500w, /images/synthora-about-v3-roadmap_1synthora-about-v3-roadmap.webp 744w" alt="Consultant and client smiling during an AI roadmap meeting" class="about-v3-card-image">
                    <div class="about-v3-card-footer">
                      <div class="about-v3-card-year">©2026</div>
                      <a aria-label="Plan your AI roadmap with Synthora" {...link('/contact', 'about-v3-card-arrow w-inline-block')}><svg viewBox="0 0 16 15" width="100%" height="100%" fill="currentColor" aria-hidden="true" class="about-v3-card-arrow-icon">
                          <circle cx="10.666" cy="3.2" r="1.067"></circle>
                          <circle cx="8.533" cy="1.067" r="1.067"></circle>
                          <circle cx="14.933" cy="7.466" r="1.067"></circle>
                          <circle cx="1.067" cy="7.466" r="1.067"></circle>
                          <circle cx="4.268" cy="7.466" r="1.067"></circle>
                          <circle cx="7.467" cy="7.466" r="1.067"></circle>
                          <circle cx="10.666" cy="7.466" r="1.067"></circle>
                          <circle cx="12.8" cy="9.6" r="1.067"></circle>
                          <circle cx="10.666" cy="11.733" r="1.067"></circle>
                          <circle cx="8.533" cy="13.866" r="1.067"></circle>
                          <circle cx="12.8" cy="5.333" r="1.067"></circle>
                        </svg></a>
                    </div>
                  </div>
                  <div class="corner-dots">
                    <div class="corner-dot is-tl"></div>
                    <div class="corner-dot is-tr"></div>
                    <div class="corner-dot is-bl"></div>
                    <div class="corner-dot is-br"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
