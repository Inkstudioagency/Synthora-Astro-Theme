---
import { linkFor } from '@/lib/links';
const link = linkFor(Astro.url.pathname);
---

<section class="section_home-v2-process">
        <div class="section-gap">
          <div class="container-main">
            <div class="home-v2-process-wrapper">
              <div class="home-v2-process-content">
                <div class="section-header">
                  <div reveal-anim-1="" class="section-eyebrow">
                    <div class="eyebrow-dot"></div>
                    <div class="eyebrow-dot is-top-right"></div>
                    <div class="eyebrow-dot is-bottom-left"></div>
                    <div class="eyebrow-dot is-bottom-right"></div>
                    <div class="section-eyebrow-text">Process</div>
                  </div>
                  <h2 section-title="" class="heading-style-2">Get Started In Three<br>Simple Steps</h2>
                </div>
                <a data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;],[&quot;4bd86580-aaae-036f-9d60-929b9b0f18d1&quot;]]]" data-wf-component-id="403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4" data-wf-variant-state="base" {...link('/contact-v2', 'primary-button w-inline-block')}>
