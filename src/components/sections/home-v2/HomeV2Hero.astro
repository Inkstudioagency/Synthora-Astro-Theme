              </div>
              <div class="home-v2-hero-card">
                <div class="home-v2-hero-card-image" data-w-id="7945c70b-db77-ae31-1adc-5abc7c8088a0" data-animation-type="lottie" data-src="/documents/02-visibility-chart.json" data-loop="0" data-direction="1" data-autoplay="1" data-is-ix2-target="0" data-renderer="svg" data-default-duration="5" data-duration="6" data-loading="eager"></div>
              </div>
            </div>
          </div>
        </div>
      </section>
