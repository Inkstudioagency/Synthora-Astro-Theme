---
import { linkFor } from '@/lib/links';
const link = linkFor(Astro.url.pathname);
---

<section class="section_home-v2-hero">
        <div class="home-hero-pattern-v2"></div>
        <div class="container-main">
          <div class="home-v2-hero-wrapper">
            <div class="home-v2-hero-content">
              <div class="home-v2-hero-text">
                <h1 hero-title="" class="home-v2-hero-title">Turn Workflow Into<br>AI Agent Automations</h1>
                <p page-load-2="" class="home-v2-hero-summary">Powerful and production-ready, our cloud platform has the solutions you need to succeed.</p>
              </div>
              <div page-load-3="" class="button-row">
                <a data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;],[&quot;d3600f24-3864-7b02-98b2-e7e2cd4eb54f&quot;]]]" data-wf-component-id="403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4" data-wf-variant-state="base" {...link('/pricing', 'primary-button w-inline-block')}>
                  <div class="button-text-mask">
                    <div data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f6&quot;],[&quot;d3600f24-3864-7b02-98b2-e7e2cd4eb54f&quot;]]]" class="button-text">Start For Free</div>
                    <div data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f8&quot;],[&quot;d3600f24-3864-7b02-98b2-e7e2cd4eb54f&quot;]]]" class="button-text is-hover">Start For Free</div>
                  </div>
                  <div data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34fa&quot;],[&quot;d3600f24-3864-7b02-98b2-e7e2cd4eb54f&quot;]]]" class="button-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 16 15" fill="currentColor" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="10.666" cy="3.2" r="1.067"></circle>
                      <circle cx="8.533" cy="1.067" r="1.067"></circle>
                      <circle cx="14.933" cy="7.466" r="1.067"></circle>
                      <circle cx="1.067" cy="7.466" r="1.067"></circle>
                      <circle cx="4.268" cy="7.466" r="1.067"></circle>
                      <circle cx="7.467" cy="7.466" r="1.067"></circle>
                      <circle cx="10.666" cy="7.466" r="1.067"></circle>
                      <circle cx="12.8" cy="9.6" r="1.067"></circle>
                      <circle cx="10.666" cy="11.733" r="1.067"></circle>
                      <circle cx="8.533" cy="13.866" r="1.067"></circle>
                      <circle cx="12.8" cy="5.333" r="1.067"></circle>
                    </svg></div>
                </a>
                <a data-wf-target="[[[&quot;2327f0b1-22dd-4a01-6298-d1f19bcbffe7&quot;,&quot;2327f0b1-22dd-4a01-6298-d1f19bcbffe7&quot;],[&quot;a7af8c96-21a2-8332-cdee-f98dd7b5a00c&quot;]]]" data-wf-component-id="2327f0b1-22dd-4a01-6298-d1f19bcbffe7" data-wf-variant-state="base" {...link('/contact', 'secondary-button w-inline-block')}>
