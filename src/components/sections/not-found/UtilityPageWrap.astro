---
import { linkFor } from '@/lib/links';
const link = linkFor(Astro.url.pathname);
---

<div class="utility-page-wrap">
      <div class="utility-page-content"><img src="/images/synthora-logo.svg" alt="Synthora" class="utility-page-logo">
        <div page-load-1="" class="section-eyebrow">
          <div class="eyebrow-dot"></div>
          <div class="eyebrow-dot is-top-right"></div>
          <div class="eyebrow-dot is-bottom-left"></div>
          <div class="eyebrow-dot is-bottom-right"></div>
          <p class="section-eyebrow-text">Error 404</p>
        </div>
        <h1 hero-title="" class="heading-style-1">Page Not Found</h1>
        <div page-load-2="" class="utility-hero-summary">The page you are looking for doesn&#x27;t exist or has been moved</div>
        <div page-load-3="" class="utility-hero-buttons">
          <a data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;],[&quot;300206b6-5326-c7cc-4776-755aabffbcf7&quot;]]]" data-wf-component-id="403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4" data-wf-variant-state="base" {...link('/', 'primary-button w-inline-block')}>
            <div class="button-text-mask">
              <div data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f6&quot;],[&quot;300206b6-5326-c7cc-4776-755aabffbcf7&quot;]]]" class="button-text">Back To Homepage</div>
              <div data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f8&quot;],[&quot;300206b6-5326-c7cc-4776-755aabffbcf7&quot;]]]" class="button-text is-hover">Back To Homepage</div>
            </div>
            <div data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34fa&quot;],[&quot;300206b6-5326-c7cc-4776-755aabffbcf7&quot;]]]" class="button-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 16 15" fill="currentColor" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                <circle cx="10.666" cy="3.2" r="1.067"></circle>
                <circle cx="8.533" cy="1.067" r="1.067"></circle>
                <circle cx="14.933" cy="7.466" r="1.067"></circle>
                <circle cx="1.067" cy="7.466" r="1.067"></circle>
                <circle cx="4.268" cy="7.466" r="1.067"></circle>
                <circle cx="7.467" cy="7.466" r="1.067"></circle>
                <circle cx="10.666" cy="7.466" r="1.067"></circle>
                <circle cx="12.8" cy="9.6" r="1.067"></circle>
                <circle cx="10.666" cy="11.733" r="1.067"></circle>
                <circle cx="8.533" cy="13.866" r="1.067"></circle>
                <circle cx="12.8" cy="5.333" r="1.067"></circle>
              </svg></div>
          </a>
          <a data-wf-target="[[[&quot;2327f0b1-22dd-4a01-6298-d1f19bcbffe7&quot;,&quot;2327f0b1-22dd-4a01-6298-d1f19bcbffe7&quot;],[&quot;e42d8390-e84c-04bc-70bb-cccc09b8e582&quot;]]]" data-wf-component-id="2327f0b1-22dd-4a01-6298-d1f19bcbffe7" data-wf-variant-state="base" {...link('/contact', 'secondary-button w-inline-block')}>
            <div class="button-text-mask">
              <div data-wf-target="[[[&quot;2327f0b1-22dd-4a01-6298-d1f19bcbffe7&quot;,&quot;2327f0b1-22dd-4a01-6298-d1f19bcbffe9&quot;],[&quot;e42d8390-e84c-04bc-70bb-cccc09b8e582&quot;]]]" class="button-text">Contact Support</div>
              <div data-wf-target="[[[&quot;2327f0b1-22dd-4a01-6298-d1f19bcbffe7&quot;,&quot;2327f0b1-22dd-4a01-6298-d1f19bcbffeb&quot;],[&quot;e42d8390-e84c-04bc-70bb-cccc09b8e582&quot;]]]" class="button-text is-hover">Contact Support</div>
            </div>
