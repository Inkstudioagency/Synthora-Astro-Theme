                            <div class="corner-dot is-tr"></div>
                            <div class="corner-dot is-bl"></div>
                            <div class="corner-dot is-br"></div>
                          </div>
                        </div><button type="button" class="faq-question"><span class="faq-question-text">Can I upgrade or downgrade my plan anytime?</span><span aria-hidden="true" class="faq-icon"><svg viewBox="0 0 24 24" width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg">
                              <path d="M12 4V20M4 12H20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                            </svg></span></button>
                        <div class="faq-answer">
                          <div class="faq-answer-inner">
                            <p class="faq-answer-text">Yes. Plans change instantly from your workspace settings. Upgrades are prorated for the rest of the billing cycle, and downgrades take effect at your next renewal with no lost data.</p>
                          </div>
                        </div>
                      </div>
                      <div data-wf--faq-item--variant="base" class="faq-item">
                        <div class="faq-item-bg">
