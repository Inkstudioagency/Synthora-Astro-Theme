---
import { linkFor } from '@/lib/links';
const link = linkFor(Astro.url.pathname);
---

<section class="section_home-logos">
        <div class="section-gap is-small">
          <div class="container-main">
            <div class="home-logos-wrapper">
              <div data-reveal="fade-up" class="home-logos-intro">
                <p class="home-logos-text">Join <span class="home-logos-highlight">20,000+</span> of the world&#x27;s most ambitious companies building with AI agents and automation.</p>
                <a data-wf-target="[[[&quot;1ed284f7-807c-746b-364b-85823408f81d&quot;,&quot;1ed284f7-807c-746b-364b-85823408f81d&quot;],[&quot;53ed2abc-9825-f152-f34a-bcc3883354ac&quot;,&quot;3040f348-2ef2-4d3a-5c98-40e87497e562&quot;]]]" data-wf-component-id="1ed284f7-807c-746b-364b-85823408f81d" data-wf-variant-state="base" {...link('/contact', 'secondary-button is-gray w-inline-block')}>
                  <div class="button-text-mask">
                    <div data-wf-target="[[[&quot;1ed284f7-807c-746b-364b-85823408f81d&quot;,&quot;1ed284f7-807c-746b-364b-85823408f81f&quot;],[&quot;53ed2abc-9825-f152-f34a-bcc3883354ac&quot;,&quot;3040f348-2ef2-4d3a-5c98-40e87497e562&quot;]]]" class="button-text">Talk To Sales</div>
                    <div data-wf-target="[[[&quot;1ed284f7-807c-746b-364b-85823408f81d&quot;,&quot;1ed284f7-807c-746b-364b-85823408f820&quot;],[&quot;53ed2abc-9825-f152-f34a-bcc3883354ac&quot;,&quot;3040f348-2ef2-4d3a-5c98-40e87497e562&quot;]]]" class="button-text is-hover">Talk To Sales</div>
                  </div>
                </a>
              </div>
              <div data-reveal="stagger" class="home-logos-grid">
                <div class="home-logos-tile">
                  <div class="corner-dots">
                    <div class="corner-dot is-tl"></div>
                    <div class="corner-dot is-tr"></div>
                    <div class="corner-dot is-bl"></div>
                    <div class="corner-dot is-br"></div>
                  </div>
                  <div class="home-logos-logo"><img src="/images/logo-radius.svg" loading="lazy" alt="Radius logo" class="home-logos-image"></div>
                </div>
                <div class="home-logos-tile">
                  <div class="corner-dots">
                    <div class="corner-dot is-tl"></div>
                    <div class="corner-dot is-tr"></div>
                    <div class="corner-dot is-bl"></div>
                    <div class="corner-dot is-br"></div>
                  </div>
                  <div class="home-logos-logo"><img src="/images/logo-capsule.svg" loading="lazy" alt="Capsule logo" class="home-logos-image"></div>
                </div>
                <div class="home-logos-tile">
                  <div class="corner-dots">
                    <div class="corner-dot is-tl"></div>
                    <div class="corner-dot is-tr"></div>
                    <div class="corner-dot is-bl"></div>
                    <div class="corner-dot is-br"></div>
                  </div>
                  <div class="home-logos-logo"><img src="/images/logo-leapyear.svg" loading="lazy" alt="Leapyear logo" class="home-logos-image"></div>
                </div>
                <div class="home-logos-tile">
                  <div class="corner-dots">
                    <div class="corner-dot is-tl"></div>
                    <div class="corner-dot is-tr"></div>
                    <div class="corner-dot is-bl"></div>
                    <div class="corner-dot is-br"></div>
                  </div>
                  <div class="home-logos-logo"><img src="/images/logo-railspeed.svg" loading="lazy" alt="Railspeed logo" class="home-logos-image"></div>
                </div>
                <div class="home-logos-tile">
