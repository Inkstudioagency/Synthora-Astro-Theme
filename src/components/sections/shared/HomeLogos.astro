                  </div>
                  <div class="home-logos-logo"><img src="/images/logo-foresight.svg" loading="lazy" alt="Foresight logo" class="home-logos-image"></div>
                </div>
                <div class="home-logos-tile">
                  <div class="corner-dots">
                    <div class="corner-dot is-tl"></div>
                    <div class="corner-dot is-tr"></div>
                    <div class="corner-dot is-bl"></div>
                    <div class="corner-dot is-br"></div>
                  </div>
                  <div class="home-logos-logo"><img src="/images/logo-cubekit.svg" loading="lazy" alt="Cubekit logo" class="home-logos-image is-padded"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
