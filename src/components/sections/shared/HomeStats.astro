---
import { linkFor } from '@/lib/links';
const link = linkFor(Astro.url.pathname);
---

<section class="section_home-stats">
        <div class="section-gap">
          <div class="container-main">
            <div class="home-stats-wrapper">
              <div class="home-stats-top">
                <div class="home-stats-heading">
                  <div class="section-header">
                    <div reveal-anim-1="" class="section-eyebrow">
                      <div class="eyebrow-dot"></div>
                      <div class="eyebrow-dot is-top-right"></div>
                      <div class="eyebrow-dot is-bottom-left"></div>
                      <div class="eyebrow-dot is-bottom-right"></div>
                      <div class="section-eyebrow-text">Our Impacts</div>
                    </div>
                    <h2 section-title="" class="heading-style-2">The Numbers That Define Our Success</h2>
                  </div>
                </div>
                <a data-wf-target="[[[&quot;2327f0b1-22dd-4a01-6298-d1f19bcbffe7&quot;,&quot;2327f0b1-22dd-4a01-6298-d1f19bcbffe7&quot;],[&quot;39f42353-62ad-2a17-2528-c0a9655a1316&quot;,&quot;1545a44a-df76-56ec-5ff8-3fd05a1512fb&quot;]]]" data-wf-component-id="2327f0b1-22dd-4a01-6298-d1f19bcbffe7" data-wf-variant-state="base" {...link('/about-v1', 'secondary-button w-inline-block')}>
                  <div class="button-text-mask">
                    <div data-wf-target="[[[&quot;2327f0b1-22dd-4a01-6298-d1f19bcbffe7&quot;,&quot;2327f0b1-22dd-4a01-6298-d1f19bcbffe9&quot;],[&quot;39f42353-62ad-2a17-2528-c0a9655a1316&quot;,&quot;1545a44a-df76-56ec-5ff8-3fd05a1512fb&quot;]]]" class="button-text">Learn About Us</div>
                    <div data-wf-target="[[[&quot;2327f0b1-22dd-4a01-6298-d1f19bcbffe7&quot;,&quot;2327f0b1-22dd-4a01-6298-d1f19bcbffeb&quot;],[&quot;39f42353-62ad-2a17-2528-c0a9655a1316&quot;,&quot;1545a44a-df76-56ec-5ff8-3fd05a1512fb&quot;]]]" class="button-text is-hover">Learn About Us</div>
                  </div>
                </a>
              </div>
              <div data-reveal="stagger" class="home-stats-list">
                <div class="home-stats-item">
                  <div class="home-stats-line">
                    <div class="home-stats-line-dot"></div>
                  </div>
                  <div class="home-stats-content">
                    <div data-counter="counter" class="home-stats-number">97%</div>
                    <p class="home-stats-text">Of customer queries resolved automatically</p>
                  </div>
                </div>
                <div class="home-stats-item">
                  <div class="home-stats-line">
                    <div class="home-stats-line-dot"></div>
                  </div>
                  <div class="home-stats-content">
                    <div data-counter="counter" class="home-stats-number">10X</div>
                    <p class="home-stats-text">Faster workflow execution across teams</p>
                  </div>
                </div>
                <div class="home-stats-item">
                  <div class="home-stats-line">
                    <div class="home-stats-line-dot"></div>
                  </div>
                  <div class="home-stats-content">
                    <div data-counter="counter" class="home-stats-number">85%</div>
                    <p class="home-stats-text">Less time spent on repetitive manual tasks</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
