---
import { linkFor } from '@/lib/links';
const link = linkFor(Astro.url.pathname);
---

<section class="section_home-faq">
        <div class="section-gap">
          <div class="container-main">
            <div class="home-faq-wrapper">
              <div class="home-faq-content">
                <div class="section-header">
                  <div reveal-anim-1="" class="section-eyebrow">
                    <div class="eyebrow-dot"></div>
                    <div class="eyebrow-dot is-top-right"></div>
                    <div class="eyebrow-dot is-bottom-left"></div>
                    <div class="eyebrow-dot is-bottom-right"></div>
                    <div class="section-eyebrow-text">FAQ</div>
                  </div>
                  <h2 section-title="" class="heading-style-2">Frequently Asked Questions</h2>
                  <p reveal-anim-2="" class="home-faq-summary">Straight answers to the questions teams ask before putting AI agents into production.</p>
                </div>
                <div reveal-anim-3="" class="section-button-block">
                  <a data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;],[&quot;3af94b17-b853-06f0-aa53-99b3661a2f4d&quot;,&quot;bc4eae93-062e-4ae3-37d5-d874c26737b0&quot;]]]" data-wf-component-id="403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4" data-wf-variant-state="base" {...link('/contact', 'primary-button w-inline-block')}>
                    <div class="button-text-mask">
                      <div data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f6&quot;],[&quot;3af94b17-b853-06f0-aa53-99b3661a2f4d&quot;,&quot;bc4eae93-062e-4ae3-37d5-d874c26737b0&quot;]]]" class="button-text">Book A Demo</div>
                      <div data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f8&quot;],[&quot;3af94b17-b853-06f0-aa53-99b3661a2f4d&quot;,&quot;bc4eae93-062e-4ae3-37d5-d874c26737b0&quot;]]]" class="button-text is-hover">Book A Demo</div>
                    </div>
                    <div data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34fa&quot;],[&quot;3af94b17-b853-06f0-aa53-99b3661a2f4d&quot;,&quot;bc4eae93-062e-4ae3-37d5-d874c26737b0&quot;]]]" class="button-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 16 15" fill="currentColor" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="10.666" cy="3.2" r="1.067"></circle>
                        <circle cx="8.533" cy="1.067" r="1.067"></circle>
                        <circle cx="14.933" cy="7.466" r="1.067"></circle>
                        <circle cx="1.067" cy="7.466" r="1.067"></circle>
                        <circle cx="4.268" cy="7.466" r="1.067"></circle>
                        <circle cx="7.467" cy="7.466" r="1.067"></circle>
                        <circle cx="10.666" cy="7.466" r="1.067"></circle>
                        <circle cx="12.8" cy="9.6" r="1.067"></circle>
                        <circle cx="10.666" cy="11.733" r="1.067"></circle>
                        <circle cx="8.533" cy="13.866" r="1.067"></circle>
                        <circle cx="12.8" cy="5.333" r="1.067"></circle>
                      </svg></div>
                  </a>
                </div>
              </div>
              <div data-reveal="stagger" class="home-faq-list">
                <div data-wf--faq-item--variant="base" class="faq-item">
                  <div class="faq-item-bg">
                    <div class="corner-dots">
                      <div class="corner-dot is-tl"></div>
                      <div class="corner-dot is-tr"></div>
                      <div class="corner-dot is-bl"></div>
                      <div class="corner-dot is-br"></div>
                    </div>
                  </div><button type="button" class="faq-question"><span class="faq-question-text">Can I upgrade or downgrade my plan anytime?</span><span aria-hidden="true" class="faq-icon"><svg viewBox="0 0 24 24" width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 4V20M4 12H20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                      </svg></span></button>
                  <div class="faq-answer">
                    <div class="faq-answer-inner">
                      <p class="faq-answer-text">Yes. Plans change instantly from your workspace settings. Upgrades are prorated for the rest of the billing cycle, and downgrades take effect at your next renewal with no lost data.</p>
                    </div>
                  </div>
                </div>
                <div data-wf--faq-item--variant="base" class="faq-item">
                  <div class="faq-item-bg">
                    <div class="corner-dots">
                      <div class="corner-dot is-tl"></div>
                      <div class="corner-dot is-tr"></div>
                      <div class="corner-dot is-bl"></div>
                      <div class="corner-dot is-br"></div>
                    </div>
                  </div><button type="button" class="faq-question"><span class="faq-question-text">How does the model fallback system work?</span><span aria-hidden="true" class="faq-icon"><svg viewBox="0 0 24 24" width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 4V20M4 12H20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                      </svg></span></button>
                  <div class="faq-answer">
                    <div class="faq-answer-inner">
                      <p class="faq-answer-text">Every agent has a ranked list of models. If the primary model times out, hits a rate limit or returns an error, Synthora retries the request on the next model within milliseconds, so your workflow keeps running.</p>
                    </div>
                  </div>
                </div>
                <div data-wf--faq-item--variant="base" class="faq-item">
                  <div class="faq-item-bg">
                    <div class="corner-dots">
                      <div class="corner-dot is-tl"></div>
                      <div class="corner-dot is-tr"></div>
                      <div class="corner-dot is-bl"></div>
                      <div class="corner-dot is-br"></div>
                    </div>
                  </div><button type="button" class="faq-question"><span class="faq-question-text">Can I switch models without redeploying code?</span><span aria-hidden="true" class="faq-icon"><svg viewBox="0 0 24 24" width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 4V20M4 12H20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                      </svg></span></button>
                  <div class="faq-answer">
                    <div class="faq-answer-inner">
                      <p class="faq-answer-text">Yes. Models are configured in the Synthora dashboard, not in your codebase. Change the provider or version for any agent and the new routing goes live on the very next request.</p>
                    </div>
                  </div>
                </div>
                <div data-wf--faq-item--variant="base" class="faq-item">
                  <div class="faq-item-bg">
                    <div class="corner-dots">
                      <div class="corner-dot is-tl"></div>
                      <div class="corner-dot is-tr"></div>
                      <div class="corner-dot is-bl"></div>
                      <div class="corner-dot is-br"></div>
                    </div>
                  </div><button type="button" class="faq-question"><span class="faq-question-text">Will using the SDK add noticeable latency?</span><span aria-hidden="true" class="faq-icon"><svg viewBox="0 0 24 24" width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 4V20M4 12H20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                      </svg></span></button>
                  <div class="faq-answer">
                    <div class="faq-answer-inner">
                      <p class="faq-answer-text">The SDK adds only a few milliseconds per call. Requests go to the nearest edge region, and caching, retries and logging run in the background so they never block a response.</p>
                    </div>
                  </div>
                </div>
                <div data-wf--faq-item--variant="base" class="faq-item">
                  <div class="faq-item-bg">
                    <div class="corner-dots">
                      <div class="corner-dot is-tl"></div>
                      <div class="corner-dot is-tr"></div>
                      <div class="corner-dot is-bl"></div>
                      <div class="corner-dot is-br"></div>
                    </div>
                  </div><button type="button" class="faq-question"><span class="faq-question-text">Can I self-host the orchestration layer?</span><span aria-hidden="true" class="faq-icon"><svg viewBox="0 0 24 24" width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 4V20M4 12H20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                      </svg></span></button>
                  <div class="faq-answer">
                    <div class="faq-answer-inner">
                      <p class="faq-answer-text">Enterprise plans can run the orchestration layer inside your own cloud or VPC. Prompts and data never leave your infrastructure, and you keep the same dashboard and analytics.</p>
                    </div>
                  </div>
                </div>
                <div data-wf--faq-item--variant="base" class="faq-item">
                  <div class="faq-item-bg">
                    <div class="corner-dots">
                      <div class="corner-dot is-tl"></div>
                      <div class="corner-dot is-tr"></div>
                      <div class="corner-dot is-bl"></div>
                      <div class="corner-dot is-br"></div>
                    </div>
                  </div><button type="button" class="faq-question"><span class="faq-question-text">How do you keep our data secure?</span><span aria-hidden="true" class="faq-icon"><svg viewBox="0 0 24 24" width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 4V20M4 12H20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                      </svg></span></button>
                  <div class="faq-answer">
                    <div class="faq-answer-inner">
                      <p class="faq-answer-text">All data is encrypted in transit and at rest, access is managed with role-based permissions, and your prompts and outputs are never used to train models. SOC 2 Type II reports are available on request.</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
