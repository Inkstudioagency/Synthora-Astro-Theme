---
import { linkFor } from '@/lib/links';
const link = linkFor(Astro.url.pathname);
---

<section class="section_cta">
        <div class="section-gap">
          <div class="container-main">
            <div reveal-2s="" class="cta-panel">
              <div class="cta-panel-content">
                <div class="cta-panel-text">
                  <h2 section-title="" class="heading-style-2">Unleash The Power Of Efficiency Business</h2>
                  <p reveal-anim-2="" class="cta-panel-summary">Join leading enterprises using Synthora to scale operations, reduce costs, and deliver results faster than ever before.</p>
                </div>
                <div reveal-anim-3="" class="cta-text-block">
                  <a data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;],[&quot;ac05a90b-ab6f-d307-5116-77bad32f3902&quot;,&quot;dc7da3ae-70ae-8b6c-60a5-91b09a0fd453&quot;]]]" data-wf-component-id="403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4" data-wf-variant-state="base" {...link('/contact', 'primary-button w-inline-block')}>
                    <div class="button-text-mask">
                      <div data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f6&quot;],[&quot;ac05a90b-ab6f-d307-5116-77bad32f3902&quot;,&quot;dc7da3ae-70ae-8b6c-60a5-91b09a0fd453&quot;]]]" class="button-text">Talk To Sales</div>
                      <div data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f8&quot;],[&quot;ac05a90b-ab6f-d307-5116-77bad32f3902&quot;,&quot;dc7da3ae-70ae-8b6c-60a5-91b09a0fd453&quot;]]]" class="button-text is-hover">Talk To Sales</div>
                    </div>
                    <div data-wf-target="[[[&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34f4&quot;,&quot;403d8bcb-23c5-ae0d-e0ae-e76c4e0d34fa&quot;],[&quot;ac05a90b-ab6f-d307-5116-77bad32f3902&quot;,&quot;dc7da3ae-70ae-8b6c-60a5-91b09a0fd453&quot;]]]" class="button-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 16 15" fill="currentColor" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="10.666" cy="3.2" r="1.067"></circle>
                        <circle cx="8.533" cy="1.067" r="1.067"></circle>
                        <circle cx="14.933" cy="7.466" r="1.067"></circle>
                        <circle cx="1.067" cy="7.466" r="1.067"></circle>
                        <circle cx="4.268" cy="7.466" r="1.067"></circle>
                        <circle cx="7.467" cy="7.466" r="1.067"></circle>
                        <circle cx="10.666" cy="7.466" r="1.067"></circle>
                        <circle cx="12.8" cy="9.6" r="1.067"></circle>
                        <circle cx="10.666" cy="11.733" r="1.067"></circle>
                        <circle cx="8.533" cy="13.866" r="1.067"></circle>
                        <circle cx="12.8" cy="5.333" r="1.067"></circle>
                      </svg></div>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
