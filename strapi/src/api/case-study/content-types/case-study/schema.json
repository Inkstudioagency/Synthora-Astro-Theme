{
  "kind": "collectionType",
  "collectionName": "case_studies",
  "info": {
    "singularName": "case-study",
    "pluralName": "case-studies",
    "displayName": "Case Study",
    "description": "Customer stories shown in the Home V3 / About V3 slider and on /case-study/[slug]"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "summary": {
      "type": "text",
      "required": true
    },
    "company": {
      "type": "string",
      "required": true
    },
    "industry": {
      "type": "string"
    },
    "companySize": {
      "type": "string"
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "cardImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "stats": {
      "type": "component",
      "repeatable": true,
      "component": "shared.stat",
      "max": 2
    },
    "quote": {
      "type": "text",
      "required": true
    },
    "quoteAuthor": {
      "type": "component",
      "repeatable": false,
      "component": "shared.person"
    },
    "body": {
      "type": "blocks"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
